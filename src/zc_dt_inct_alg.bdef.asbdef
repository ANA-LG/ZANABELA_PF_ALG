projection implementation in class zbp_c_dt_inct_alg unique;
strict ( 2 );
use draft;
use side effects;
define behavior for ZC_DT_INCT_ALG alias Incident
use etag
{
  use create;
  use update;
  use delete;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action changeStatus;

  use association _History { create; }
}

define behavior for ZC_INCT_H_ALG alias History
use etag
{
  use update;
  use delete;

  use association _Incident { with draft; }
}