managed implementation in class zbp_r_dt_inct_alg unique;

strict ( 2 );
with draft;

define behavior for ZR_DT_INCT_ALG alias Incident //alias <alias_name>
implementation in class zbp_r_dt_inct_alg unique

persistent table zdt_inct_alg
draft table zdt_inct_algd

lock master total etag lastChangedAt
etag master localLastChangedAt
authorization master ( global, instance )

{
  create ( authorization : global );
  update;
  delete;

  field ( readonly )
  IncidentID,
  //  Status,
  CreationDate,
  ChangedDate,
  LocalCreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt;

  //  association _History { create; }
  association _History { create ( features : instance ); with draft; }

  field ( numbering : managed, readonly ) IncUUID;


  field ( mandatory )
  title,
  Description,
  Priority;

  //Accion que vincula el campo con la entidad abstracta
  action ( features : instance, authorization : update ) changeStatus
    parameter ZDD_NUEVO_STATUS_PARAM_ALG result [1] $self;

  //  side effects { action changeStatus affects $self; }

  internal action setHistory;

  determination setDefaultHistory on save { create; }
  determination setDefaultValues on modify { create; }


  validation validateTitle on save { create; update; field Title; }
  validation validateDescription on save { create; update; field Description; }
  validation validateStatus on save { create; update; field Status; }
  validation validatePriority on save { create; update; field Priority; }

  determine action validateTitlet { validation validateTitle; }
  determine action validateDescriptiont { validation validateDescription; }
  determine action validateStatus_code { validation validateStatus; }
  determine action validatePriority_code { validation validatePriority; }

  side effects
  {
    action changeStatus affects messages, $self;
    determine action validateTitlet executed on field Title affects messages;
    determine action validateDescriptiont executed on field Description affects messages;
    determine action validateStatus_code executed on field Status affects messages;
  }


  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;

  draft determine action Prepare;

  mapping for zdt_inct_alg
    {
      IncUUID            = inc_uuid;
      IncidentID         = incident_id;
      Title              = title;
      Description        = description;
      Status             = status;
      Priority           = priority;
      CreationDate       = creation_date;
      ChangedDate        = changed_date;
      LocalCreatedBy     = local_created_by;
      LocalCreatedAt     = local_created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }
}

define behavior for ZDD_INCT_H_ALG alias History //alias <alias_name>
//implementation in class zbp_dd_inct_h_alg unique
persistent table zdt_inct_h_alg
draft table zdt_inct_h_algd
lock dependent by _Incident
authorization dependent by _Incident
etag master LocalLastChangedAt
{
  update;
  delete;
  field ( readonly )
  HisUUID,
  IncUUID,
  LocalCreatedBy,
  LocalCreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  lastChangedAt;

  field ( numbering : managed )
  HisUUID;

  association _Incident { with draft; }

  mapping for zdt_inct_h_alg
    {
      HisUUID            = his_uuid;
      IncUUID            = inc_uuid;
      HisID              = his_id;
      PreviousStatus     = previous_status;
      NewStatus          = new_status;
      Text               = text;
      LocalCreatedBy     = local_created_by;
      LocalCreatedAt     = local_created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }

}